\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Ensemble structure on held-out data.} \textbf  {(A)} Residual rank correlation between the five members. Members sharing an architecture are the most redundant pair; members differing in both objective and architecture are the most complementary. \textbf  {(B)} Each member's individual held-out Spearman. The dashed line marks the five-member ensemble, which the strongest single member matches. \textbf  {(C)} Change in held-out Spearman when each member is removed. Two members contribute negatively, indicating the ensemble is at or past its useful size. Panels (B) and (C) are post-hoc analyses on held-out data and did not inform the frozen model choice (\S  \ref  {sec:ens-honest}).\relax }}{25}{figure.caption.40}\protected@file@percent }
\newlabel{fig:members}{{4}{25}{\textbf {Ensemble structure on held-out data.} \textbf {(A)} Residual rank correlation between the five members. Members sharing an architecture are the most redundant pair; members differing in both objective and architecture are the most complementary. \textbf {(B)} Each member's individual held-out Spearman. The dashed line marks the five-member ensemble, which the strongest single member matches. \textbf {(C)} Change in held-out Spearman when each member is removed. Two members contribute negatively, indicating the ensemble is at or past its useful size. Panels (B) and (C) are post-hoc analyses on held-out data and did not inform the frozen model choice (\S \ref {sec:ens-honest}).\relax }{figure.caption.40}{}}
