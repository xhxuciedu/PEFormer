\newlabel{tab:main}{{2}{10}{Held-out performance. No model was trained on these rows.\relax }{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Held-out benchmark result.} \textbf  {(A)} Spearman $\rho $ on the complete held-out set and on each source partition, across successive model generations. All models were trained on the identical corpus and cross-validation splits and evaluated on identical rows; the dotted line marks the baseline's overall performance. The advantage is consistently larger on the Kim partition, which spans more cell lines and editing systems. \textbf  {(B)} Distribution of the paired difference in Spearman $\rho $ under a protospacer-clustered bootstrap (5{,}000 resamples over 750 clusters). Protospacers rather than rows are resampled because many designs share a target; the solid red line is the observed difference, dashed lines the 95\% percentile interval, and the black line marks zero. \textbf  {(C)} Held-out performance broken down by experimental condition ($n\geq 300$), coloured by source study. Performance spans $0.21$ between the weakest and strongest conditions, and the weakest are those with the highest fraction of exactly-zero measurements (cf.\ Figure\nobreakspace  {}\ref  {fig:ceiling}B).\relax }}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:bench}{{2}{11}{\textbf {Held-out benchmark result.} \textbf {(A)} Spearman $\rho $ on the complete held-out set and on each source partition, across successive model generations. All models were trained on the identical corpus and cross-validation splits and evaluated on identical rows; the dotted line marks the baseline's overall performance. The advantage is consistently larger on the Kim partition, which spans more cell lines and editing systems. \textbf {(B)} Distribution of the paired difference in Spearman $\rho $ under a protospacer-clustered bootstrap (5{,}000 resamples over 750 clusters). Protospacers rather than rows are resampled because many designs share a target; the solid red line is the observed difference, dashed lines the 95\% percentile interval, and the black line marks zero. \textbf {(C)} Held-out performance broken down by experimental condition ($n\geq 300$), coloured by source study. Performance spans $0.21$ between the weakest and strongest conditions, and the weakest are those with the highest fraction of exactly-zero measurements (cf.\ Figure~\ref {fig:ceiling}B).\relax }{figure.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Paired protospacer-clustered bootstrap, 5{,}000 resamples over 750 clusters, on identical rows.\relax }}{11}{table.caption.15}\protected@file@percent }
\newlabel{tab:boot}{{3}{11}{Paired protospacer-clustered bootstrap, 5{,}000 resamples over 750 clusters, on identical rows.\relax }{table.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Which components are responsible}{12}{subsection.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Objective $\times $ architecture factorial, out-of-fold development Spearman, fold-averaged.\relax }}{12}{table.caption.16}\protected@file@percent }
\newlabel{tab:factorial}{{4}{12}{Objective $\times $ architecture factorial, out-of-fold development Spearman, fold-averaged.\relax }{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Separating the two contributions.} \textbf  {(A)} Out-of-fold development Spearman for each combination of outcome head and sequence mixer. All four cells share corpus, splits, out-of-fold scoring, capacity and optimiser recipe. \textbf  {(B)} Main effects and interaction derived from (A). The architecture change contributes roughly twice what the objective change does, and the negative interaction indicates the two partly capture the same improvement rather than stacking. \textbf  {(C)} Why the ordinal head is nonetheless valuable: residual correlation with the existing ensemble, for every candidate model of each head type (points; bars are group means). Ordinal-head models separate cleanly from simplex-head models, i.e.\ they make \emph  {different errors}, which is what determines a member's value in an ensemble (\S  \ref  {sec:ensemble}). Lower is more complementary.\relax }}{12}{figure.caption.17}\protected@file@percent }
\newlabel{fig:fact}{{3}{12}{\textbf {Separating the two contributions.} \textbf {(A)} Out-of-fold development Spearman for each combination of outcome head and sequence mixer. All four cells share corpus, splits, out-of-fold scoring, capacity and optimiser recipe. \textbf {(B)} Main effects and interaction derived from (A). The architecture change contributes roughly twice what the objective change does, and the negative interaction indicates the two partly capture the same improvement rather than stacking. \textbf {(C)} Why the ordinal head is nonetheless valuable: residual correlation with the existing ensemble, for every candidate model of each head type (points; bars are group means). Ordinal-head models separate cleanly from simplex-head models, i.e.\ they make \emph {different errors}, which is what determines a member's value in an ensemble (\S \ref {sec:ensemble}). Lower is more complementary.\relax }{figure.caption.17}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}The ordinal head produces decorrelated errors}{13}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Ensemble structure on held-out data.} \textbf  {(A)} Residual rank correlation between the five members. Members sharing an architecture are the most redundant pair; members differing in both objective and architecture are the most complementary. \textbf  {(B)} Each member's individual held-out Spearman. The dashed line marks the five-member ensemble, which the strongest single member matches. \textbf  {(C)} Change in held-out Spearman when each member is removed. Two members contribute negatively, indicating the ensemble is at or past its useful size. Panels (B) and (C) are post-hoc analyses on held-out data and did not inform the frozen model choice (\S  \ref  {sec:ens-honest}).\relax }}{13}{figure.caption.18}\protected@file@percent }
\newlabel{fig:members}{{4}{13}{\textbf {Ensemble structure on held-out data.} \textbf {(A)} Residual rank correlation between the five members. Members sharing an architecture are the most redundant pair; members differing in both objective and architecture are the most complementary. \textbf {(B)} Each member's individual held-out Spearman. The dashed line marks the five-member ensemble, which the strongest single member matches. \textbf {(C)} Change in held-out Spearman when each member is removed. Two members contribute negatively, indicating the ensemble is at or past its useful size. Panels (B) and (C) are post-hoc analyses on held-out data and did not inform the frozen model choice (\S \ref {sec:ens-honest}).\relax }{figure.caption.18}{}}
