\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}Calibration restores absolute efficiency}{14}{subsection.3.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Effect of monotone calibration on held-out predictions. The map is fitted entirely on development data and verified non-decreasing.\relax }}{14}{table.caption.19}\protected@file@percent }
\newlabel{tab:calib}{{5}{14}{Effect of monotone calibration on held-out predictions. The map is fitted entirely on development data and verified non-decreasing.\relax }{table.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Monotone calibration restores an absolute efficiency scale.} \textbf  {(A)} The learned map $g$ from the ensemble's rank score to efficiency, fitted by isotonic regression on out-of-fold development predictions only and then applied once to the frozen held-out predictions. \textbf  {(B)} Calibration curve on held-out data, binned by predicted quantile; the dotted line is perfect calibration. \textbf  {(C)} Metric comparison. Because $g$ is non-decreasing it inverts no pair, so Spearman is unchanged, while Pearson correlation rises and absolute error falls roughly eight-fold.\relax }}{15}{figure.caption.20}\protected@file@percent }
\newlabel{fig:calib}{{5}{15}{\textbf {Monotone calibration restores an absolute efficiency scale.} \textbf {(A)} The learned map $g$ from the ensemble's rank score to efficiency, fitted by isotonic regression on out-of-fold development predictions only and then applied once to the frozen held-out predictions. \textbf {(B)} Calibration curve on held-out data, binned by predicted quantile; the dotted line is perfect calibration. \textbf {(C)} Metric comparison. Because $g$ is non-decreasing it inverts no pair, so Spearman is unchanged, while Pearson correlation rises and absolute error falls roughly eight-fold.\relax }{figure.caption.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.7}The benchmark is not saturated}{15}{subsection.3.7}\protected@file@percent }
\newlabel{sec:headroom}{{3.7}{15}{The benchmark is not saturated}{subsection.3.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Kim partition headroom against the empirical repeatability ceiling, development folds.\relax }}{15}{table.caption.21}\protected@file@percent }
\newlabel{tab:ceiling}{{6}{15}{Kim partition headroom against the empirical repeatability ceiling, development folds.\relax }{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {The benchmark is not saturated.} \textbf  {(A)} Model performance against the empirical repeatability ceiling for each Kim condition, ordered by zero-inflation; the annotation gives the gap. Headroom is present in every condition. \textbf  {(B)} The gap to ceiling increases with the fraction of rows measured as exactly zero, the regime in which a single measurement is least informative. \textbf  {(C)} Both corrections described in \S  \ref  {sec:ceiling} are load-bearing. A naive replicate key merges epegRNA with plain-pegRNA constructs and returns a ceiling essentially equal to the model's own score (dashed line), which would wrongly indicate saturation; treating observed zeros as noiseless instead over-estimates it. Only the corrected, censoring-aware estimate is trustworthy.\relax }}{16}{figure.caption.22}\protected@file@percent }
\newlabel{fig:ceiling}{{6}{16}{\textbf {The benchmark is not saturated.} \textbf {(A)} Model performance against the empirical repeatability ceiling for each Kim condition, ordered by zero-inflation; the annotation gives the gap. Headroom is present in every condition. \textbf {(B)} The gap to ceiling increases with the fraction of rows measured as exactly zero, the regime in which a single measurement is least informative. \textbf {(C)} Both corrections described in \S \ref {sec:ceiling} are load-bearing. A naive replicate key merges epegRNA with plain-pegRNA constructs and returns a ceiling essentially equal to the model's own score (dashed line), which would wrongly indicate saturation; treating observed zeros as noiseless instead over-estimates it. Only the corrected, censoring-aware estimate is trustworthy.\relax }{figure.caption.22}{}}
